{
  "rules": {
    "color-no-invalid-hex": true,
    "declaration-block-no-duplicate-properties": true,
    "block-no-empty": true,
    "declaration-property-value-disallowed-list": {
      "/.*/": ["/#[0-9a-fA-F]{3,8}\\b/", "/\\b[0-9.]+(?:px|rem|ms)\\b/"]
    }
  },
  "overrides": [
    { "files": ["**/tokens.css"], "rules": { "declaration-property-value-disallowed-list": null } }
  ]
}
