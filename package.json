{
  "name": "chulane-workspace",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "pnpm --filter @chulane/ui --filter ui-catalog run format",
    "format:check": "pnpm --filter @chulane/ui --filter ui-catalog run format:check",
    "lint:fix": "pnpm --filter @chulane/ui --filter ui-catalog run lint:fix"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
